@host = http://localhost:5080

### Health
GET {{host}}/health

### All genres
GET {{host}}/api/genres

### Create genre
POST {{host}}/api/genres
Content-Type: application/json

{ "name": "Strategy" }

### All studios
GET {{host}}/api/studios

### Studio by id
GET {{host}}/api/studios/1

### Create studio
POST {{host}}/api/studios
Content-Type: application/json

{ "name": "Ubisoft" }

### Update studio
PUT {{host}}/api/studios/1
Content-Type: application/json

{ "name": "Capcom" }

### Delete studio
DELETE {{host}}/api/studios/1

### Validation error example (400 ProblemDetails)
POST {{host}}/api/studios
Content-Type: application/json

{ "name": "" }

### Games (paged, filtered)
GET {{host}}/api/games?page=1&pageSize=5&search=fi

### Game by id
GET {{host}}/api/games/4

### Create game
POST {{host}}/api/games
Content-Type: application/json

{ "name": "Age of Empires IV", "genreId": 1, "studioId": 1, "price": 49.99, "releaseDate": "2021-10-28" }

### Update game
PUT {{host}}/api/games/1
Content-Type: application/json

{ "name": "Street Fighter II Turbo", "genreId": 1, "studioId": 1, "price": 24.99, "releaseDate": "1992-07-16" }

### Delete game
DELETE {{host}}/api/games/9

### Validation error example (400 ProblemDetails)
POST {{host}}/api/games
Content-Type: application/json

{ "name": "", "genreId": 0, "studioId": 0, "price": -5, "releaseDate": "2021-10-28" }

### Authentication
POST {{host}}/api/auth/login
Content-Type: application/json

{ "Email": "admin@gamestore.local", "Password": "@Admin2004" }

