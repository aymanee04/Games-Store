@host = http://localhost:5080
@jwt = access_token

###  create a full-access key readonly true
POST {{host}}/api/mcp/keys
Authorization: Bearer {{jwt}}
Content-Type: application/json

{ "name": "assistant", "expiresInDays": 90, "readOnly": false }

### create a full-access key readonly false
POST {{host}}/api/mcp/keys
Authorization: Bearer {{jwt}}
Content-Type: application/json

{ "name": "copilot", "expiresInDays": 90, "readOnly": false }
